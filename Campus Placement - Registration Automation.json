    {
      "parameters": {
        "jsCode": "// Get form data\nconst input = $input.first().json;\nconst data = input.body || input.data || input;\n\n// Find field by name\nfunction getField(...names) {\n  for (const key of Object.keys(data)) {\n    const lowerKey = key.toLowerCase();\n    for (const n of names) {\n      if (lowerKey.includes(n.toLowerCase())) return data[key];\n    }\n  }\n  return \"\";\n}\n\nconst cgpa = parseFloat(getField(\"cgpa\", \"current cgpa\")) || 0;\nconst backlogs = parseInt(getField(\"backlog\")) || 0;\nconst gradPercent = parseFloat(getField(\"graduation percentage\", \"percentage\")) || 0;\nconst skills = String(getField(\"skills\") || \"\");\nconst internship = String(getField(\"internship\") || \"\");\n\n// AI Logic - Calculate Score\nlet score = 0;\nscore += cgpa * 8;\nif (gradPercent >= 75) score += 10;\nelse if (gradPercent >= 60) score += 5;\nif (skills.length > 10) score += 5;\nif (internship.toLowerCase().includes(\"yes\") || internship.length > 5) score += 5;\nif (backlogs > 0) score -= (backlogs * 5);\nif (score > 100) score = 100;\nif (score < 0) score = 0;\nscore = Math.round(score);\n\nlet eligibility = \"Not Eligible\";\nlet reason = \"\";\n\nif (cgpa >= 6.5 && backlogs <= 1 && gradPercent >= 60) {\n  eligibility = \"Eligible\";\n  reason = \"Eligible: CGPA \" + cgpa + \", Backlogs \" + backlogs + \", Graduation \" + gradPercent + \"% meets criteria.\";\n} else {\n  reason = \"Not Eligible: CGPA \" + cgpa + \", Backlogs \" + backlogs + \", Graduation \" + gradPercent + \"% does not meet criteria (Need CGPA >=6.5, Backlogs <=1, Graduation >=60%).\";\n}\n\nreturn [{\n  json: {\n    ...data,\n    \"AI Score\": score,\n    \"Eligibility Status\": eligibility,\n    \"AI Reason\": reason\n  }\n}];"
      },
